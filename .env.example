# ─── SmartNest environment ─────────────────────────────────────────────
# Copy to `.env` in the repository root. Never commit the real `.env`.

NODE_ENV=development

# PostgreSQL (docker compose exposes the dev database on 5442)
DATABASE_URL=postgresql://smartnest:smartnest@localhost:5442/smartnest?schema=public
# Used by the server integration tests (created automatically by `npm test`)
TEST_DATABASE_URL=postgresql://smartnest:smartnest@localhost:5442/smartnest_test?schema=public

# HTTP
PORT=4317
# Origin(s) allowed by CORS, comma-separated. In dev the Vite proxy makes requests same-origin.
WEB_ORIGIN=http://localhost:5317
# Public URL of the web app, used to build invitation and password-reset links
PUBLIC_APP_URL=http://localhost:5317

# 32-byte key, base64 encoded, used to encrypt integration credentials at rest (AES-256-GCM).
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=

# Secret used to sign short-lived camera stream tokens.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STREAM_TOKEN_SECRET=

# Session lifetime in hours
SESSION_TTL_HOURS=168

# Command confirmation timeout (ms). Commands with no confirmed read-back by then are marked timed_out.
COMMAND_TIMEOUT_MS=10000

# Logging: trace | debug | info | warn | error
LOG_LEVEL=info

# Allow Home Assistant URLs on private networks (normal for self-hosted HA). Set to false on a public SaaS deployment.
ALLOW_PRIVATE_INTEGRATION_HOSTS=true
